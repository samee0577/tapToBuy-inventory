# ---------------------------------------------------------------------------
# Inventory Management System - environment template
#
# Copy to the locations below and fill in real values. NEVER commit a real .env.
#
#   cp .env.example apps/api/.env      # backend runtime secrets
#   cp .env.example apps/web/.env      # frontend (VITE_* only)
#
# Anything NOT prefixed with VITE_ is server-side only. Vite physically cannot
# expose non-VITE_ variables to the browser bundle.
# ---------------------------------------------------------------------------

# ============================ DATABASE (Neon PostgreSQL) ====================
# Use the POOLED connection string for runtime and the DIRECT (unpooled) one
# for migrations, which Prisma requires.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connection_limit=5&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ============================ AUTH =========================================
# 64+ random bytes. Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# Session cookie lifetime in seconds. Short by design: the API re-checks the
# user's isActive flag on every request, so deactivation takes effect at once.
SESSION_TTL_SECONDS=900

# Argon2id parameters. Raise memoryCost for stronger hardening.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Public registration is OFF by default (§28: only Admin manages users).
# The first Admin is created with `pnpm --filter @inventory/api user:bootstrap`.
REGISTRATION_ENABLED=false

# ============================ GOOGLE OAUTH =================================
# Authorized redirect URI: {API_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================ CLOUDINARY (product images) ===================
# The browser uploads product photos straight to Cloudinary using a signature
# minted by this API, so the file never passes through Express. The API secret is
# what makes that signature trustworthy and must never reach the frontend.
#
# Do NOT create an unsigned upload preset: it would let anyone upload to your
# account without going through this API.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upload constraints. The allowed-formats list is baked into the upload signature,
# so a tampered request cannot widen it.
CLOUDINARY_UPLOAD_FOLDER="products"
CLOUDINARY_MAX_UPLOAD_BYTES=5242880
CLOUDINARY_MIN_DIMENSION=400
CLOUDINARY_MAX_DIMENSION=6000
CLOUDINARY_ALLOWED_FORMATS="jpg,jpeg,png,webp"

# ============================ RUNTIME ======================================
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins. Browsers send Origin even on
# same-origin POSTs, so production must list the deployed origin here.
CORS_ORIGINS="http://localhost:5173"
# Number of proxy hops to trust for X-Forwarded-*. Must be 1 on Vercel, where
# the function always sees one reverse proxy: without it req.ip is the proxy
# itself (defeating rate limiting) and req.protocol is http (breaking the Google
# OAuth redirect URI).
TRUST_PROXY=false
LOG_LEVEL=info

# ============================ RATE LIMITING ================================
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ============================ FRONTEND =====================================
# Same-origin in production (single Vercel project serves /api + SPA).
VITE_API_URL="/api"

# ============================ VERCEL ONLY ==================================
# These are set in the Vercel dashboard, not here. They are listed so that the
# reason for each one survives, not because they belong in a local .env.
#
#   NODEJS_HELPERS=0   Vercel otherwise parses the request body itself, which
#                      starves express.json() and breaks every POST/PATCH.
#   TRUST_PROXY=true   See above; required for req.ip and req.protocol.
#   VERCEL_ENV         Read-only. Set to "preview" by Vercel, which is how the
#                      API knows to accept the randomised *.vercel.app host that
#                      each preview deployment is given.
