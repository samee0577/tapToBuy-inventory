{
  "name": "inventory-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter \"@inventory/api\" --filter \"@inventory/web\" dev",
    "dev:api": "pnpm --filter @inventory/api dev",
    "dev:web": "pnpm --filter @inventory/web dev",
    "build": "pnpm --filter @inventory/shared build && pnpm --filter @inventory/api build && pnpm --filter @inventory/web build",
    "typecheck": "pnpm -r --stream typecheck",
    "lint": "pnpm -r --stream lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\"",
    "test": "pnpm -r --stream test",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
